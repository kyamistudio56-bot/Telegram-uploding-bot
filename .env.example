# TELEGRAM BOT CONFIGURATION
# Your Telegram Bot Token obtained from @BotFather (e.g. 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
BOT_TOKEN="YOUR_BOT_TOKEN_HERE"

# Authorized Telegram User IDs (comma-separated numeric IDs e.g. 123456789,987654321)
# Users can find their ID via @userinfobot or in the CMS web panel
BOT_OWNER_IDS="YOUR_NUMERIC_TELEGRAM_ID_HERE"

# Timezone for user-facing scheduling (default: Asia/Kolkata)
DEFAULT_TIMEZONE="Asia/Kolkata"

# Port (bound to 3000 in cloud environment)
PORT=3000

# Optional Telegram Webhook Settings (Leave blank to use default single polling worker)
TELEGRAM_WEBHOOK_URL=""
TELEGRAM_WEBHOOK_SECRET=""

# GEMINI_API_KEY: Optional
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

